{
  "name": "dalmuti",
  "version": "2.0.0",
  "description": "The Great Dalmuti online game (socket.io)",
  "main": "app.js",
  "scripts": {
    "build": "npm run build:js && npm run build:css",
    "build:css": "postcss src/css/tailwind.css -o src/css/app.css",
    "build:js": "esbuild src/ts/main.ts src/ts/login.ts --bundle --minify --target=es2020 --format=iife --outdir=src/js",
    "watch:css": "postcss src/css/tailwind.css -o src/css/app.css --watch",
    "typecheck": "tsc --noEmit",
    "start": "node app.js",
    "test": "node --test \"test/**/*.test.js\""
  },
  "author": "MG",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^11.3.0",
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "express-session": "^1.18.0",
    "helmet": "^7.1.0",
    "passport": "^0.7.0",
    "passport-local": "^1.0.0",
    "socket.io": "^4.8.0"
  },
  "devDependencies": {
    "autoprefixer": "^10.6.1",
    "esbuild": "^0.25.12",
    "postcss": "^8.5.29",
    "postcss-cli": "^11.0.1",
    "socket.io-client": "^4.8.0",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=18 <23"
  }
}
